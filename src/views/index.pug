//- Main status page template.
//- Follows IsSeptaFcked views/index.pug pattern: bold status display with
//- dynamic CSS class, metrics, and timestamp.
extends layouts/main

block content
  .status-container
    h1.site-title Ist BVG gefickt?

    //- Bold status display with dynamic CSS class
    .status(class=statusClass)
      span.status-emoji= emoji
      .status-text= message

    //- Metrics section
    if metrics && metrics.totalServices > 0
      .metrics
        .metric
          span.metric-value= metrics.percentDelayed + '%'
          span.metric-label  verspaetet
        .metric
          span.metric-value= metrics.percentCancelled + '%'
          span.metric-label  ausgefallen
        .metric
          span.metric-value= metrics.totalServices
          span.metric-label  Abfahrten

    //- Transit boxes section
    .transit-boxes
      .transit-box
        .transit-box-header Bus
        .transit-box-stats
          .transit-stat
            span.transit-stat-value#bus-delayed-count 0
            span.transit-stat-label verspaetet
          .transit-stat
            span.transit-stat-value#bus-cancelled-count 0
            span.transit-stat-label ausgefallen
      .transit-box
        .transit-box-header U-Bahn
        .transit-box-stats
          .transit-stat
            span.transit-stat-value#ubahn-delayed-count 0
            span.transit-stat-label verspaetet
          .transit-stat
            span.transit-stat-value#ubahn-cancelled-count 0
            span.transit-stat-label ausgefallen
      .transit-box
        .transit-box-header Tram
        .transit-box-stats
          .transit-stat
            span.transit-stat-value#tram-delayed-count 0
            span.transit-stat-label verspaetet
          .transit-stat
            span.transit-stat-value#tram-cancelled-count 0
            span.transit-stat-label ausgefallen
      .transit-box
        .transit-box-header S-Bahn
        .transit-box-stats
          .transit-stat
            span.transit-stat-value#sbahn-delayed-count 0
            span.transit-stat-label verspaetet
          .transit-stat
            span.transit-stat-value#sbahn-cancelled-count 0
            span.transit-stat-label ausgefallen

    //- Staleness warning
    if stale
      .stale-warning Daten sind veraltet.

    //- Timestamp and auto-refresh indicator
    .footer-info
      if timestamp
        .timestamp Zuletzt aktualisiert: #{timestamp}
      .refresh-indicator Automatische Aktualisierung alle 60 Sekunden
